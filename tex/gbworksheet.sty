\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{gbworksheet}[2026/07/08 Worksheet Layout]

% ============================================================
% Required packages
% ============================================================

\RequirePackage[
    letterpaper,
    margin=0.75in
]{geometry}

\RequirePackage{graphicx}
\RequirePackage{tikz}
\RequirePackage{tikzpagenodes}
\RequirePackage{xcolor}
\RequirePackage{calc}
\RequirePackage{etoolbox}
% amsmath: LLM-generated question/answer text is inserted verbatim and is
% told to use "real LaTeX math notation" (worksheetbot.py's
% GENERATION_SYSTEM_PROMPT), which includes constructs like \text{...} that
% plain LaTeX doesn't define. Without this, such questions fail to compile.
\RequirePackage{amsmath}

\usetikzlibrary{calc}

\pagestyle{empty}

% ============================================================
% Internal configuration
% ============================================================

\makeatletter

% Registration marker geometry. The inset is the distance from the paper edge
% to the marker's OUTER edge; it must clear a consumer printer's non-printable
% margin (~0.17-0.25in) plus fit-to-page shrink, or the printout clips the
% marker's black border and cv2.aruco can no longer decode it (issue #35). The
% marker is deliberately small -- worksheet identity rides on the QR code, so
% the fiducials only need to be large enough to localize. MUST stay in sync with
% _MARKER_SIZE_IN / _MARKER_INSET_IN in graderbot/registration.py.
\def\worksheet@markersize{0.50in}
\def\worksheet@markerinset{0.40in}
\def\worksheet@markerdirectory{aruco_images}
\def\worksheet@frameinset{0.85in}

% Worksheet id, embedded on the page as a QR code (issue #11). Empty by
% default so worksheets without an id (e.g. demo.tex) still compile. When set,
% a PNG named qr_<id>.png must be present in the compile directory.
\def\worksheet@id{}
\def\worksheet@qrsize{0.8in}
\def\worksheet@qrinset{0.15in}
% In cv mode, a locator box is drawn around the QR code so graderbot can find
% the QR region. It must NOT be red: extract_answer_boxes treats red rectangles
% as answer boxes, so the QR locator uses a distinct color.
\def\worksheet@qrcvcolor{blue}
\def\worksheet@qrcvlinewidth{2pt}
\def\worksheet@qrcvpadding{2pt}

\def\worksheet@markerTL{0}
\def\worksheet@markerTR{1}
\def\worksheet@markerBL{2}
\def\worksheet@markerBR{3}

\def\worksheet@nameboxwidth{3.75in}
\def\worksheet@nameboxheight{0.6in}
\def\worksheet@namecvcolor{red}
\def\worksheet@namecvlinewidth{2pt}
\def\worksheet@namelinewidth{0.5pt}

% Name-collection worksheet (issue #41). The printed target name graderbot
% fills into the exemplar box; empty by default so the template still compiles
% without one. The grid geometry is stored as bare numbers (inches) because the
% grid is laid out with pgfmath arithmetic in \WorksheetNameGrid.
%
% The collection boxes MUST be the same size as the header/exemplar name box
% (\worksheet@nameboxwidth x \worksheet@nameboxheight = 3.75in x 0.6in) so the
% handwriting samples match the box a student fills on a real worksheet -- a
% wider box changes how a name is spaced and sized. That full width leaves no
% room for a second column across the text block, so the grid is a single
% column.
\def\worksheet@studentname{}
% The box size is fixed (see above), so the header + 9 rows must fit one letter
% page (issue #45) by controlling the inter-row gap: at 0.6in boxes, a gap much
% above 0.2in spills the ninth box onto a second page. 0.16in keeps all 9 on one
% page with headroom for printer fit-to-page shrink.
\def\worksheet@ngboxwidth{3.75}   % collection box width  (inches, numeric)
\def\worksheet@ngboxheight{0.6}   % collection box height (inches, numeric)
\def\worksheet@ngvgap{0.16}       % vertical gap between rows
\def\worksheet@ngrows{9}          % number of boxes (one column)

\newif\ifworksheet@frame
\worksheet@framefalse

\newif\ifworksheet@cvmode
\worksheet@cvmodefalse

% ============================================================
% Configuration interface
% ============================================================

\pgfkeys{
    /worksheet/.is family,
    /worksheet,
    marker size/.store in=\worksheet@markersize,
    marker inset/.store in=\worksheet@markerinset,
    marker directory/.store in=\worksheet@markerdirectory,
    worksheet id/.store in=\worksheet@id,
    qr cv color/.store in=\worksheet@qrcvcolor,
    frame inset/.store in=\worksheet@frameinset,
    top left marker/.store in=\worksheet@markerTL,
    top right marker/.store in=\worksheet@markerTR,
    bottom left marker/.store in=\worksheet@markerBL,
    bottom right marker/.store in=\worksheet@markerBR,
    show frame/.is if=worksheet@frame,
    cv mode/.is if=worksheet@cvmode,
    name box width/.store in=\worksheet@nameboxwidth,
    name box height/.store in=\worksheet@nameboxheight,
    name cv color/.store in=\worksheet@namecvcolor,
    student name/.store in=\worksheet@studentname,
    name grid rows/.store in=\worksheet@ngrows,
    name grid box width/.store in=\worksheet@ngboxwidth,
    name grid box height/.store in=\worksheet@ngboxheight,
    name grid vgap/.store in=\worksheet@ngvgap,
}

% Allow overriding cv mode from the command line, e.g.
%   latexmk -pdf -usepretex='\def\WSCVMode{0}' demo.tex
% Applied at \begin{document} so it wins over any \WorksheetSetup{cv mode=...}
% already given in the source file.
\AtBeginDocument{%
    \ifdefined\WSCVMode
        \ifnum\WSCVMode=1
            \worksheet@cvmodetrue
        \else
            \worksheet@cvmodefalse
        \fi
    \fi
}

\newcommand{\WorksheetSetup}[1]{%
    \pgfkeys{/worksheet,#1}
}

% ============================================================
% Internal helper
% ============================================================

\newcommand{\worksheet@PlaceMarker}[3]{%
    \node[
        anchor=#1,
        inner sep=0pt
    ] at #2
    {
        \includegraphics[
            width=\worksheet@markersize,
            height=\worksheet@markersize
        ]
        {\worksheet@markerdirectory/aruco_#3}
    };
}

% ============================================================
% Draw registration markers
% ============================================================
%
% \WorksheetMarkers itself only draws once, wherever it's invoked from -- a
% tikz `remember picture, overlay` node is positioned relative to whichever
% page it's typeset on. \WorksheetHeader/\WorksheetNameHeader call it inline
% just once near the top of the document, so on a multi-page worksheet only
% page 1 got registration markers -- rectify_to_canonical (and the QR-id
% decode alongside it) then fails on every later page during grading. Instead
% of calling \WorksheetMarkers directly, they register it on the LaTeX2e
% shipout/background hook (\worksheet@EnsureMarkersOnEveryPage below), which
% fires fresh for every page shipout, so every page gets its own markers.
\newif\ifworksheet@markershookadded
\worksheet@markershookaddedfalse

\newcommand{\worksheet@EnsureMarkersOnEveryPage}{%
    \ifworksheet@markershookadded\else
        \AddToHook{shipout/background}{\WorksheetMarkers}%
        \worksheet@markershookaddedtrue
    \fi
}

\newcommand{\WorksheetMarkers}{%
\begin{tikzpicture}[remember picture,overlay]

    \ifworksheet@frame
        \draw[line width=0.5pt]
            ($(current page.north west)+(\worksheet@frameinset,-\worksheet@frameinset)$)
            rectangle
            ($(current page.south east)+(-\worksheet@frameinset,\worksheet@frameinset)$);
    \fi

    \worksheet@PlaceMarker
        {north west}
        {($(current page.north west)+(\worksheet@markerinset,-\worksheet@markerinset)$)}
        {\worksheet@markerTL}

    \worksheet@PlaceMarker
        {north east}
        {($(current page.north east)+(-\worksheet@markerinset,-\worksheet@markerinset)$)}
        {\worksheet@markerTR}

    \worksheet@PlaceMarker
        {south west}
        {($(current page.south west)+(\worksheet@markerinset,\worksheet@markerinset)$)}
        {\worksheet@markerBL}

    \worksheet@PlaceMarker
        {south east}
        {($(current page.south east)+(-\worksheet@markerinset,\worksheet@markerinset)$)}
        {\worksheet@markerBR}

    % Worksheet id QR code, top-center in the top margin, clear of the four
    % corner registration markers. Only drawn when an id has been set.
    \ifx\worksheet@id\empty\else
        \node[
            anchor=north,
            inner sep=0pt
        ] (worksheet@qrnode) at ($(current page.north)+(0,-\worksheet@qrinset)$)
        {
            \includegraphics[
                width=\worksheet@qrsize,
                height=\worksheet@qrsize
            ]
            {qr_\worksheet@id}
        };
        % In cv mode, outline the QR with a locator box so graderbot can find
        % the QR region on an aligned scan.
        \ifworksheet@cvmode
            \draw[
                draw=\worksheet@qrcvcolor,
                line width=\worksheet@qrcvlinewidth
            ]
            ($(worksheet@qrnode.north west)+(-\worksheet@qrcvpadding,\worksheet@qrcvpadding)$)
            rectangle
            ($(worksheet@qrnode.south east)+(\worksheet@qrcvpadding,-\worksheet@qrcvpadding)$);
        \fi
    \fi

\end{tikzpicture}
}

% ============================================================
% Name box
% ============================================================

\newcommand{\worksheet@NameBox}{%
\tikz[baseline=-0.6ex]{

    \ifworksheet@cvmode

        \draw[
            draw=\worksheet@namecvcolor,
            line width=\worksheet@namecvlinewidth
        ]
        (0,0)
        rectangle
        (\worksheet@nameboxwidth,\worksheet@nameboxheight);

        \node[
            font=\tiny,
            text=\worksheet@namecvcolor
        ]
        at
        (.5*\worksheet@nameboxwidth,.5*\worksheet@nameboxheight)
        {name};

    \else

        \draw[
            line width=\worksheet@namelinewidth
        ]
        (0,0)
        rectangle
        (\worksheet@nameboxwidth,\worksheet@nameboxheight);

    \fi
}
}

% ============================================================
% Worksheet header
% ============================================================

\newcommand{\WorksheetHeader}{%

\worksheet@EnsureMarkersOnEveryPage

\vspace*{0.5in}

\noindent
\begin{tabular*}{\textwidth}{@{\extracolsep{\fill}}ll}
\textbf{Name:} & \textbf{Date:}\\
\worksheet@NameBox & \hrulefill
\end{tabular*}

\vspace{0.25in}
}

% ============================================================
% Worksheet title/header (issue #42)
% ============================================================
% An optional title and free-text instructions block rendered below
% \WorksheetHeader, above the questions. graderbot only emits this macro call
% when at least one of title/header is set, but \ifblank guards each argument
% independently so a title-only or header-only call still renders cleanly.
\newcommand{\WorksheetTitleBlock}[2]{%
\ifblank{#1}{}{\noindent{\Large\bfseries #1}\par\vspace{0.05in}}%
\ifblank{#2}{}{\noindent #2\par}%
\vspace{0.2in}
}

% ============================================================
% Name-collection worksheet (issue #41)
% ============================================================
%
% A sheet for gathering labelled handwriting samples to train a name
% classifier. graderbot prints a target name in the exemplar box at the top;
% the student copies it into a grid of blank boxes below, so every grid box
% becomes one training sample whose label is the printed name.
%
% In blank (student-facing) mode the exemplar box is a plain black box holding
% the printed name. In cv mode it becomes a red, id-labelled box (`printedname`)
% with the name omitted, so extract_answer_boxes returns its location alongside
% the grid boxes -- ingest crops it to OCR the printed name as each sheet's
% label (issue #2). The name is dropped in cv mode so the only text inside the
% red rectangle is the id (extract_answer_boxes concatenates all enclosed text
% into the box id). The grid boxes reuse the same cv convention -- red border
% plus a tiny id label INSIDE the rectangle -- because extract_answer_boxes
% skips any red box that contains no text (the id).

% One collection box. #1,#2 are the top-left corner (bare numbers, inches);
% #3 is the box id. In cv mode: red border + tiny in-box id label so the box is
% discoverable by extract_answer_boxes. In blank mode: a plain box to write in.
\newcommand{\worksheet@CollectBox}[3]{%
    \pgfmathsetmacro{\worksheet@cbxr}{#1+\worksheet@ngboxwidth}%
    \pgfmathsetmacro{\worksheet@cbyb}{#2-\worksheet@ngboxheight}%
    \ifworksheet@cvmode
        \draw[
            draw=\worksheet@namecvcolor,
            line width=\worksheet@namecvlinewidth
        ]
        (#1in,#2in) rectangle (\worksheet@cbxr in,\worksheet@cbyb in);
        \node[
            font=\tiny,
            text=\worksheet@namecvcolor,
            anchor=south west,
            inner sep=1pt
        ] at (#1in,\worksheet@cbyb in) {#3};
    \else
        \draw[line width=\worksheet@namelinewidth]
        (#1in,#2in) rectangle (\worksheet@cbxr in,\worksheet@cbyb in);
    \fi
}

% The single column of blank name boxes, each the same size as the header/
% exemplar name box. Boxes are numbered name1, name2, ... top-to-bottom.
\newcommand{\WorksheetNameGrid}{%
\begin{center}
\begin{tikzpicture}
    \foreach \worksheet@r in {1,...,\worksheet@ngrows}{%
        \pgfmathsetmacro{\worksheet@gy}{-(\worksheet@r-1)*(\worksheet@ngboxheight+\worksheet@ngvgap)}%
        \worksheet@CollectBox{0}{\worksheet@gy}{name\worksheet@r}%
    }%
\end{tikzpicture}
\end{center}
}

% Header for the name-collection sheet: registration markers + QR, then the
% printed exemplar name in a name-style box (black in blank mode, a red
% `printedname` box in cv mode), then the copying instructions.
\newcommand{\WorksheetNameHeader}{%

\worksheet@EnsureMarkersOnEveryPage

\vspace*{0.5in}

\noindent\textbf{Check that the name written at the top is yours.  Then write your name below into every box, just as you would write it
at the top of a handout.}

\vspace{0.2in}

\noindent\textbf{Name:}\\[4pt]
\noindent
\tikz{
    \ifworksheet@cvmode
        \draw[
            draw=\worksheet@namecvcolor,
            line width=\worksheet@namecvlinewidth
        ]
        (0,0) rectangle (\worksheet@nameboxwidth,\worksheet@nameboxheight);
        \node[
            font=\tiny,
            text=\worksheet@namecvcolor,
            anchor=south west,
            inner sep=1pt
        ] at (0,0) {printedname};
    \else
        \draw[line width=\worksheet@namelinewidth]
            (0,0) rectangle (\worksheet@nameboxwidth,\worksheet@nameboxheight);
        \node[font=\Large] at
            (.5*\worksheet@nameboxwidth,.5*\worksheet@nameboxheight)
            {\worksheet@studentname};
    \fi
}

\vspace{0.25in}
}

\makeatother

\endinput